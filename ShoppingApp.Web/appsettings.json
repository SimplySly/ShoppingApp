{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "Path": "Logs/Log-.txt",
          "RollingInterval": "Minute",
          "OutputTemplate": "{{\"Timestamp\": {Timestamp:o}, \"Level\":\"{Level}\", \"Message\":\"{Message}\", \"Exception\":\"{Exception}\"\\}}{NewLine}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "Application": "ShoppingApp API"
    }
  },
  "ConnectionStrings": {
    "ShoppingAppDb": "in-user-sercrets"
  },
  "Jwt": {
    "SecretKey": "in-user-secrets",
    "Issuer": "https://localhost:7159",
    "Audience": "ShoppingAppApi",
    "ExpirationInMinutes": 1,
    "RefreshTokenExpiryInDays": 30,
    "ClockSkewInMinutes": 0
  }
}
